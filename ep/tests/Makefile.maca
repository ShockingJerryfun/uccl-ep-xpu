MACA_PATH ?= /opt/maca
CUCC := $(MACA_PATH)/tools/cu-bridge/bin/cucc
CXX := g++
GCC_INSTALL_DIR := $(dir $(shell $(CXX) -print-libgcc-file-name))

INCLUDES := -I../include -I../../include -I$(MACA_PATH)/include -I$(MACA_PATH)/include/mcr -I$(MACA_PATH)/tools/cu-bridge/include
CXXFLAGS := -O3 -std=c++17 $(INCLUDES) -D__MC_PLATFORM_MXCC__ -DDISABLE_SM90_FEATURES
CUCCFLAGS := --maca-path=$(MACA_PATH) --gcc-install-dir=$(GCC_INSTALL_DIR) -fno-strict-aliasing -rdc=true
LDFLAGS := -L$(MACA_PATH)/lib -Wl,-rpath,$(MACA_PATH)/lib -Wl,-rpath-link,$(MACA_PATH)/lib -libverbs -lnuma -lpthread

MACA_BIN := primitive_test d2h_queue_test gpu_to_cpu_bench intranode_combine_test

all: $(MACA_BIN)

primitive_test: primitive_test.cu $(wildcard ../include/*.cuh)
	$(CUCC) $(CUCCFLAGS) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

fifo_maca.o: ../src/fifo.cpp ../include/fifo.hpp ../include/fifo_device.hpp ../include/fifo_util.hpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

d2h_queue_test: d2h_queue_test.cu fifo_maca.o $(wildcard ../include/*.cuh) $(wildcard ../include/*.hpp)
	$(CUCC) $(CUCCFLAGS) $(CXXFLAGS) $< fifo_maca.o -o $@ $(LDFLAGS)

gpu_to_cpu_bench: gpu_to_cpu_bench.cu ../../include/util/gpu_rt.h
	$(CUCC) $(CUCCFLAGS) $(CXXFLAGS) $< -o $@ $(LDFLAGS)

intranode_combine_test: intranode_combine_test.cu ../src/intranode.cu $(wildcard ../include/*.cuh)
	$(CUCC) $(CUCCFLAGS) $(CXXFLAGS) $< ../src/intranode.cu -o $@ $(LDFLAGS)

clean:
	rm -f $(MACA_BIN) fifo_maca.o

.PHONY: all clean
